# ==============================================================================
# CONFIGURACIÓN DEL SERVIDOR SMTP (Envío de Correos Electrónicos de Confirmación)
# ==============================================================================
# Para enviar correos reales de confirmación a los clientes tras agendar su cita,
# completa estas variables. Si no se configuran, el sistema simula el envío y
# registra el comprobante en el panel del barbero.
#
# EJEMPLO CON GMAIL:
# 1. Ve a tu Cuenta de Google -> Seguridad -> Verificación en dos pasos.
# 2. En "Contraseñas de aplicaciones", genera una nueva llamada "Barbería".
# 3. Copia esa contraseña de 16 letras y colócala en SMTP_PASS.
#
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# SMTP_USER="tu-correo@gmail.com"
# SMTP_PASS="xxxx xxxx xxxx xxxx"
# SMTP_FROM="Barbería Imperial <tu-correo@gmail.com>"
#
# EJEMPLO CON OUTLOOK / OFFICE 365:
# SMTP_HOST="smtp.office365.com"
# SMTP_PORT="587"
# SMTP_USER="tu-correo@outlook.com"
# SMTP_PASS="tu_contraseña"
# SMTP_FROM="Barbería Imperial <tu-correo@outlook.com>"

SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# ==============================================================================
# NOTIFICACIONES PUSH EN VIVO PARA BARBEROS (WEB PUSH / VAPID)
# ==============================================================================
# Si se dejan en blanco, el servidor autogenera y persiste automáticamente las
# claves VAPID en 'data/vapid.json' para que funcionen de inmediato.
# Si deseas fijarlas manualmente en Render:
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:contacto@barberturnos.com"

# ==============================================================================
# SEGURIDAD Y CREDENCIALES
# ==============================================================================
# Contraseña de acceso inicial al Panel del Superusuario (por defecto: barbero123):
BARBER_PASSWORD="barbero123"

# Directorio de persistencia SQLite (opcional, por defecto ./data):
# DATA_DIR="/app/data"

# Modo de entorno (development o production):
NODE_ENV="production"

