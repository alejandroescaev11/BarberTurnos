# ==============================================================================
# CONFIGURACIÓN DEL SERVIDOR SMTP (Envío de Correos Electrónicos de Confirmación)
# ==============================================================================
# Para enviar correos reales de confirmación a los clientes tras agendar su cita,
# completa estas variables. Si no se configuran, el sistema simula el envío y
# registra el comprobante en el panel del barbero.
#
# EJEMPLO CON GMAIL:
# 1. Ve a tu Cuenta de Google -> Seguridad -> Verificación en dos pasos.
# 2. En "Contraseñas de aplicaciones", genera una nueva llamada "Barbería".
# 3. Copia esa contraseña de 16 letras y colócala en SMTP_PASS.
#
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# SMTP_USER="tu-correo@gmail.com"
# SMTP_PASS="xxxx xxxx xxxx xxxx"
# SMTP_FROM="Barbería Imperial <tu-correo@gmail.com>"
#
# EJEMPLO CON OUTLOOK / OFFICE 365:
# SMTP_HOST="smtp.office365.com"
# SMTP_PORT="587"
# SMTP_USER="tu-correo@outlook.com"
# SMTP_PASS="tu_contraseña"
# SMTP_FROM="Barbería Imperial <tu-correo@outlook.com>"

SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# ==============================================================================
# INTEGRACIÓN GOOGLE SHEETS
# ==============================================================================
# URL de la Aplicación Web de Google Apps Script (/exec):
GOOGLE_SHEETS_SCRIPT_URL=""

# Contraseña de acceso al Panel Privado del Barbero (por defecto: barbero123):
BARBER_PASSWORD=""

# Variables del Sistema AI Studio:
GEMINI_API_KEY=""
APP_URL=""
